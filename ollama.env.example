# Opcional. Copia este archivo como ollama.env solo si quieres cambiar los
# valores por defecto. ollama.env esta en .gitignore.

# Direccion donde corre Ollama.
OLLAMA_HOST=http://127.0.0.1:11434

# Modelo que entiende imagenes. Descargalo antes con: ollama pull gemma3:4b
OLLAMA_VISION_MODEL=gemma3:4b

# Segundos que espera la respuesta del modelo.
OLLAMA_TIMEOUT=180
