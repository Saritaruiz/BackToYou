# Opcional. Copia este archivo como email.env para que BackToYou envie
# correos de verdad: recuperar la contrasena (RF39) y notificaciones (RF15).
# email.env esta en .gitignore, nunca se sube a GitHub.
# Sin email.env los correos se muestran en la terminal.

# Cuenta de Gmail que envia los correos y su contrasena de aplicacion
# (16 letras). Se crea en https://myaccount.google.com/apppasswords
# y necesita la verificacion en dos pasos activada.
EMAIL_HOST_USER=tu.cuenta@gmail.com
EMAIL_HOST_PASSWORD=

# Nombre y correo que ven las personas como remitente.
DEFAULT_FROM_EMAIL=BackToYou <tu.cuenta@gmail.com>

# Servidor de Gmail. No hace falta cambiarlo.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
