# Opcional. Copia este archivo como gemini.env para que la sugerencia con IA
# (RF22) la haga Google Gemini en vez de Ollama. No hace falta tener Ollama
# instalado ni descargar el modelo.
# gemini.env esta en .gitignore, nunca se sube a GitHub.
# En el servidor de AWS estos valores van en /etc/backtoyou.env.

# Clave de la API. Se crea en https://aistudio.google.com/apikey
# Con clave, la app usa Gemini; sin clave, usa Ollama.
GEMINI_API_KEY=

# Modelo de Gemini que entiende imagenes.
GEMINI_MODEL=gemini-3.5-flash-lite

# Segundos que espera la respuesta.
GEMINI_TIMEOUT=60
