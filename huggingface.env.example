# Copia este archivo como huggingface.env y pon tu token de Hugging Face
# (huggingface.co > Settings > Access tokens). huggingface.env esta en
# .gitignore: nunca se sube a GitHub.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

# Opcional. Modelo que entiende imagenes para describir la foto del objeto.
HF_VISION_MODEL=google/gemma-3-4b-it
